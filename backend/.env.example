ENVIRONMENT=production
DATABASE_URL=sqlite+aiosqlite:///./news.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ORIGINS=https://news.example.com
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?news\.example\.com
ALLOWED_HOSTS=news.example.com,api.example.com
