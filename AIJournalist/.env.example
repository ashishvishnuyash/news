# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# The Republic Bulletin backend (start it separately).
SITE_API_URL=http://localhost:8000
SITE_USERNAME=
SITE_PASSWORD=

# Optional identification sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIJournalist

# Runtime defaults. These can also be selected interactively.
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_MAX_ARTICLES=5
REQUEST_TIMEOUT_SECONDS=30

